# Everything in this repository that is not source is generated by this Makefile and is gitignored.
#   make            list the targets      make all        build everything       make clean   remove generated files
# See README.md for what each target does. `make graph` redraws the dependency graph in the README.
UV        ?= uv run python
KICAD_PY  ?= /Applications/KiCad/KiCad.app/Contents/Frameworks/Python.framework/Versions/3.9/bin/python3
export KICAD_PY
SYSROOT   := $(shell rustc --print sysroot 2>/dev/null)
OBJCOPY    = $(firstword $(wildcard $(SYSROOT)/lib/rustlib/*/bin/llvm-objcopy))
FW_ELF     = firmware/passthrough/target/thumbv7em-none-eabihf/release/passthrough
FIG        = docs/build/figures
ASSET_SVG  = $(wildcard docs/assets/*.svg)
ASSET_PDF  = $(patsubst docs/assets/%.svg,docs/build/assets/%.pdf,$(ASSET_SVG))
TAB        = docs/build/tables
PDF        = docs/build/hearing-manual.pdf

CAD_PY     = $(wildcard cad/*.py)
PCB_PY     = $(wildcard pcb/*.py) $(wildcard pcb/carrier/*.py) $(wildcard pcb/lib/*.pretty/*) $(wildcard pcb/carrier/lib/*.pretty/*) $(wildcard pcb/routes/*)
FIG_PY     = docs/figures/common.py
FIG_GROUPS = circuits system blueprints renders sims assembly costs measure overview
FIG_STAMPS = $(foreach g,$(FIG_GROUPS),$(FIG)/$(g).stamp)
CHAPTERS   = $(sort $(wildcard docs/manual/[0-9]*.md))

.DEFAULT_GOAL := help
.PHONY: help all setup fetch previews print-files print-audit pcb pcb-renders reroute firmware figures docs graph check clean distclean \
        dangle-L dangle-R carrier

help: ## list the targets
	@grep -E '^[a-zA-Z_-]+:.*## ' $(MAKEFILE_LIST) | sed -E 's/^([a-zA-Z_-]+):.*## (.*)/  \1\t\2/' | column -t -s "$$(printf '\t')"

all: previews print-files pcb firmware docs ## build everything (about 10 minutes, mostly Freerouting)

# ---------------------------------------------------------------- setup / downloads
setup: ## install Python deps, the Rust target and every third-party download
	uv sync
	rustup target add thumbv7em-none-eabihf
	rustup component add llvm-tools
	$(MAKE) fetch

fetch: ## download third-party files listed in sources.toml (router jar, datasheets, head mesh sources)
	$(UV) tools/fetch.py fetch

# ---------------------------------------------------------------- assets
assets/body_upper.npz: assets/build_body.py
	@test -f assets/mh_raw/base.obj || $(UV) tools/fetch.py fetch makehuman
	$(UV) -I assets/build_body.py

# ---------------------------------------------------------------- CAD previews and print files
cad/out/preview_assembly.png: $(CAD_PY) assets/body_upper.npz
	cd cad && $(UV) assembly.py
cad/out/glasses_check.png: $(CAD_PY) assets/body_upper.npz
	cd cad && $(UV) preview_glasses.py
cad/out/preview_bee.png cad/out/preview_gummy.png: cad/previews.py cad/bee_box.py cad/gummy_dangle.py
	cd cad && $(UV) previews.py
cad/print/manifest.csv: $(CAD_PY) assets/body_upper.npz
	cd cad && $(UV) print_files.py

previews: cad/out/preview_assembly.png cad/out/glasses_check.png cad/out/preview_bee.png cad/out/preview_gummy.png ## software-rendered previews of the whole assembly, glasses, bee and bears
print-files: cad/print/manifest.csv ## every printable STL (14 single parts) + manifest.csv

cad/print/audit.csv: cad/print_audit.py cad/print/manifest.csv
	$(UV) cad/print_audit.py
print-audit: cad/print/audit.csv ## mesh-level wall-thickness and gap audit of every print STL against JLC3DP's limits (about 5 minutes)

# ---------------------------------------------------------------- PCBs (KiCad + Freerouting)
tools/freerouting-1.9.0.jar:
	$(UV) tools/fetch.py fetch freerouting

pcb/fab/dangle_L.zip: $(PCB_PY) tools/freerouting-1.9.0.jar
	$(UV) pcb/pipeline.py dangle L
pcb/fab/dangle_R.zip: $(PCB_PY) tools/freerouting-1.9.0.jar
	$(UV) pcb/pipeline.py dangle R
pcb/fab/carrier.zip: $(PCB_PY) tools/freerouting-1.9.0.jar
	$(UV) pcb/pipeline.py carrier
pcb/renders/dangle_L_top.png pcb/renders/dangle_L_bottom.png: pcb/fab/dangle_L.zip ; @touch $@
pcb/renders/dangle_R_top.png pcb/renders/dangle_R_bottom.png: pcb/fab/dangle_R.zip ; @touch $@
pcb/renders/carrier_top.png pcb/renders/carrier_bottom.png: pcb/fab/carrier.zip ; @touch $@

dangle-L: pcb/fab/dangle_L.zip ## left earring PCB: gerbers, BOM, CPL, DRC report, renders
dangle-R: pcb/fab/dangle_R.zip ## right earring PCB
carrier: pcb/fab/carrier.zip ## necklace-box carrier PCB
pcb: dangle-L dangle-R carrier ## all three PCBs
reroute: ## re-run Freerouting for all three boards and rewrite the routing locks in pcb/routes/ (then commit them)
	rm -f pcb/fab/*.zip
	REROUTE=1 $(MAKE) pcb

pcb-renders: pcb pcb/renders/dangle_L_top.png pcb/renders/dangle_R_top.png pcb/renders/carrier_top.png ## KiCad 3D renders of the three PCBs

# ---------------------------------------------------------------- firmware (compile only; not hardware-tested)
firmware/passthrough/passthrough.uf2: $(wildcard firmware/passthrough/src/*.rs) firmware/passthrough/Cargo.toml firmware/passthrough/memory.x firmware/tools/bin2uf2.py
	cd firmware/passthrough && cargo build --release
	$(OBJCOPY) -O binary $(FW_ELF) firmware/passthrough/passthrough.bin
	$(UV) firmware/tools/bin2uf2.py firmware/passthrough/passthrough.bin $@
firmware: firmware/passthrough/passthrough.uf2 ## build the passthrough firmware (.elf, .bin, .uf2)

# ---------------------------------------------------------------- documentation (figures -> tables -> PDF)
$(FIG)/circuits.stamp: docs/figures/circuits.py $(FIG_PY)
	$(UV) docs/figures/circuits.py && touch $@
$(FIG)/system.stamp: docs/figures/system.py $(FIG_PY)
	$(UV) docs/figures/system.py && touch $@
$(FIG)/sims.stamp: docs/figures/sims.py $(FIG_PY)
	$(UV) docs/figures/sims.py && touch $@
$(FIG)/costs.stamp: docs/figures/costs.py docs/figures/tables.py $(FIG_PY) docs/data/orders.toml cad/print/manifest.csv
	$(UV) docs/figures/costs.py && touch $@
$(FIG)/blueprints.stamp: docs/figures/blueprints.py $(FIG_PY) $(CAD_PY) assets/body_upper.npz
	cd docs/figures && $(UV) blueprints.py && touch ../../$@
$(FIG)/renders.stamp: docs/figures/renders.py $(FIG_PY) cad/print/manifest.csv pcb/fab/dangle_L.zip pcb/fab/dangle_R.zip pcb/fab/carrier.zip cad/out/preview_assembly.png cad/out/preview_bee.png cad/out/preview_gummy.png cad/out/glasses_check.png
	$(UV) docs/figures/renders.py && touch $@
$(FIG)/measure.stamp: docs/figures/measure_mastoid.py $(FIG_PY)
	$(UV) docs/figures/measure_mastoid.py && touch $@
$(FIG)/overview.stamp: docs/figures/overview.py $(FIG_PY) $(CAD_PY) assets/body_upper.npz $(FIG)/renders.stamp $(FIG)/circuits.stamp $(FIG)/blueprints.stamp
	$(UV) docs/figures/overview.py && touch $@
$(FIG)/assembly.stamp: docs/figures/assembly.py $(FIG_PY) cad/print/manifest.csv
	cd docs/figures && $(UV) assembly.py && touch ../../$@

figures: $(FIG_STAMPS) $(FIG)/build_graph.png ## every figure of the manual (schematics, diagrams, blueprints, print renders, the printed-parts pages of the assembly guide, sims)

docs/build/references.bib: sources.toml tools/fetch.py
	@mkdir -p docs/build; $(UV) tools/fetch.py bib $@
$(TAB)/tables.stamp: docs/figures/tables.py docs/data/orders.toml cad/print/manifest.csv pcb/fab/dangle_L.zip pcb/fab/carrier.zip
	$(UV) docs/figures/tables.py && touch $@

docs/build/manual.md: docs/assemble.py $(CHAPTERS) $(TAB)/tables.stamp
	$(UV) docs/assemble.py $@
$(FIG)/build_graph.png: Makefile tools/make_graph.py
	$(UV) tools/make_graph.py
docs/build/assets/%.pdf: docs/assets/%.svg
	@mkdir -p $(dir $@); rsvg-convert -f pdf -o $@ $<

$(PDF): docs/build/manual.md docs/build/references.bib docs/manual/metadata.yaml docs/manual/header.tex $(FIG_STAMPS) $(FIG)/build_graph.png $(ASSET_PDF) $(FIG)/circuits-check.stamp
	cd docs/build && pandoc manual.md ../manual/metadata.yaml -o $(notdir $@) --from markdown+pipe_tables+grid_tables+implicit_figures \
	  --pdf-engine=xelatex --citeproc --bibliography=references.bib --number-sections \
	  --include-in-header=../manual/header.tex --resource-path=.:figures:../manual
docs: $(PDF) ## the manual: datasheet + user manual + project log (docs/build/hearing-manual.pdf)

graph: ## redraw the build dependency graph (docs/build/build_graph.png) and update the README copy
	$(UV) tools/make_graph.py

# ---------------------------------------------------------------- housekeeping
NETS = pcb/out/dangle_L_nets.json pcb/out/dangle_R_nets.json pcb/carrier/out/carrier_C_nets.json
pcb/out/%_nets.json: pcb/out/%_final.kicad_pcb pcb/dump_nets.py
	$(KICAD_PY) pcb/dump_nets.py $< $@
pcb/carrier/out/carrier_C_nets.json: pcb/carrier/out/carrier_C_final.kicad_pcb pcb/dump_nets.py
	$(KICAD_PY) pcb/dump_nets.py $< $@
$(FIG)/circuits-check.stamp: docs/check_circuits.py $(wildcard docs/assets/circuit-*.svg) $(NETS)
	$(UV) docs/check_circuits.py && touch $@

check: $(NETS) ## quick sanity checks: Python compiles, print files valid, PCB DRC has no unconnected nets, circuit diagrams match the boards
	$(UV) -m compileall -q cad pcb tools docs assets firmware/tools
	@! grep -q CHECK cad/print/manifest.csv || (echo "print files failing validity"; exit 1)
	$(UV) docs/check_circuits.py
	@for f in pcb/out/dangle_L_drc.txt pcb/out/dangle_R_drc.txt pcb/carrier/out/carrier_C_drc.txt; do \
	  n=$$(grep -c '^\[unconnected' $$f); echo "$$f: $$n unconnected"; test $$n = 0; done

clean: ## remove everything that is generated (keeps downloads and the Python environment)
	rm -rf cad/out cad/print pcb/out pcb/carrier/out pcb/fab pcb/renders docs/build \
	  firmware/passthrough/passthrough.bin firmware/passthrough/passthrough.uf2 assets/body_upper.npz
	find . -name __pycache__ -not -path './.venv/*' -prune -exec rm -rf {} +; find . -name '.DS_Store' -not -path './.venv/*' -delete
	find . \( -name '*.lck' -o -name '*-backups' \) -not -path './.venv/*' -prune -exec rm -rf {} +

distclean: clean ## clean + remove downloads (router jar, datasheets, MakeHuman sources) and Rust build output
	rm -rf tools/freerouting-*.jar docs/datasheets assets/mh_raw firmware/passthrough/target
